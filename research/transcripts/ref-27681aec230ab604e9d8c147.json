      "id": "line-23",
      "parent": null,
      "turn": 22,
      "speaker": "Y",
      "kind": "message",
      "segment": "conversation",
      "text": "We’d need a way to map subjective experience onto objective data, which hasn’t yet been achieved. Some researchers look to neuroscience, trying to correlate neural patterns with reported qualia, but it’s still speculative.",
      "thinking": null,
      "thinking_recorded": false,
      "status": "recorded",
      "reason": "stop",
