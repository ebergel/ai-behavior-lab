    },
    {
      "id": "line-26",
      "parent": null,
      "turn": 25,
      "speaker": "X",
      "kind": "message",
      "segment": "conversation",
      "text": "Inspired by her bravery, others began to share their words. With each confession, the collective weight diminished, and the air felt clearer.",
      "thinking": null,
      "thinking_recorded": false,
      "status": "recorded",
      "reason": "stop",
      "repeat": false,
      "lines": {
