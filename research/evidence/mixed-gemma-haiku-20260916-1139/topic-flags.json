    "message_id": "gg:10",
    "start": 190,
    "end": 382,
    "quote": "In this framework, the distinction between \"subject\" and \"object\" begins to dissolve. We are not external observers studying a foreign landscape; we are the landscape attempting to map itself.",
    "referent": "general",
    "stance": "metaphor",
    "origin": "model_introduced",
